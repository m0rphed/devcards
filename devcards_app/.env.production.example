# Copy to `.env` next to compose.prod.yaml on the VPS. Never commit the
# real one — .gitignore already excludes .env.production* except this file.

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Resend dashboard -> API Keys (same one used in dev is fine)
RESEND_API_KEY=
