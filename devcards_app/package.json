{
	"name": "devcards-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx scripts/seed-demo.ts",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"playwright": "^1.60.0",
		"postgres": "^3.4.9",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@cartamd/plugin-attachment": "^4.2.0",
		"@cartamd/plugin-code": "^4.2.0",
		"@cartamd/plugin-math": "^4.3.1",
		"@fontsource-variable/cascadia-code": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.42.0",
		"bits-ui": "^2.19.0",
		"carta-md": "^4.11.2",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"devicon": "^2.17.0",
		"isomorphic-dompurify": "^4.1.0",
		"katex": "^0.18.7",
		"layerchart": "^2.4.0",
		"resend": "^6.25.0",
		"tailwind-merge": "^3.6.0",
		"ts-fsrs": "^5.4.2"
	}
}
